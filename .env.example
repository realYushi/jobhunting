# Copy to .env and fill secrets. .env is ignored by git.

# Reactive Resume integration (optional — local PDF render via typst works without it):
# REACTIVE_RESUME_BASE_URL=https://...
# REACTIVE_RESUME_API_KEY=your-reactive-resume-api-key

# Hunter.io contact discovery (optional — used to find recruiter / hiring contacts):
# HUNTER_API_KEY=your-hunter-api-key
