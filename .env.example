# Copy to .env and fill secrets. .env is ignored by git.

# Hosted Browserless cloud. Use the CDP/WebSocket endpoint from your
# Browserless dashboard. Browserless cloud examples often look like:
#   wss://production-sfo.browserless.io?token=YOUR_TOKEN
#   wss://production-lon.browserless.io?token=YOUR_TOKEN
JOBHUNTING_BROWSER=browserless
JOBHUNTING_BROWSERLESS_CDP_WS=wss://production-sfo.browserless.io?token=your-browserless-token

# Optional: if your token is not already in the URL, set it separately.
# JOBHUNTING_BROWSERLESS_TOKEN=your-browserless-token

# Existing project integrations, if used:
# REACTIVE_RESUME_BASE_URL=https://...
# REACTIVE_RESUME_API_KEY=your-reactive-resume-api-key
